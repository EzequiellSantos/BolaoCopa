# ─────────────────────────────────────────
# BOLÃO COPA DO MUNDO - ENVIRONMENT VARS
# ─────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000

# CORS
# Separe mais de uma URL por virgula.
FRONTEND_URLS=http://localhost:5173,https://seu-frontend.vercel.app

# MongoDB Atlas
MONGODB_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin seed (primeiro usuário admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Web Push (VAPID) — notificações push
# Gere o par com: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bolao.com
CRON_SECRET=some_random_string_for_cron_jobs